<object>
  <spriteName>spr_robo_dir</spriteName>
  <solid>0</solid>
  <visible>-1</visible>
  <depth>-3</depth>
  <persistent>0</persistent>
  <parentName>obj_inimigo_pai</parentName>
  <maskName>spr_mascara_g</maskName>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Robo: lento, muita vida, dano alto, so ataca de perto (dano fisico)
event_inherited();
vida = 15;
velocidade = 0.9;
espera_ataque = 0;
guardiao = false;    // obj_robo_guardiao muda para true
image_speed = 0;</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="1" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Fase 3: o 3o robo derrotado perde o braco com o dispositivo do escudo
if (room == rm_fase3 &amp;&amp; guardiao == false) {
    obj_controle.robos_derrotados += 1;
    if (obj_controle.robos_derrotados == 3) {
        instance_create(x, y, obj_item_escudo);
    }
}</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>event_inherited();
if (global.pausado) {
    image_speed = 0;
    exit;
}
if (!instance_exists(obj_player)) exit;

// Guardioes (fase 3) ficam parados e invenciveis ate os outros robos acabarem
if (guardiao) {
    if (obj_controle.robos_comuns &gt; 0) {
        invulneravel = true;
        image_speed = 0;
        exit;
    }
    invulneravel = false;
}

if (dist &lt; 450) alerta = true;

// anda ate o jogador
if (alerta &amp;&amp; dist &gt; 40) {
    scr_mover(angulo, velocidade);
    image_speed = 0.12;
} else {
    image_speed = 0;
}

// golpe fisico (atravessa o escudo)
if (espera_ataque &gt; 0) espera_ataque -= 1;
if (dist &lt; 60 &amp;&amp; espera_ataque &lt;= 0) {
    scr_dano_jogador(25, true);
    espera_ataque = 60;
}

if (obj_player.x &lt; x) sprite_index = spr_robo_esq;
else sprite_index = spr_robo_dir;</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
</object>
