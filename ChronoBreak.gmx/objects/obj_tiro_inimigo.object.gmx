        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Tiro dos inimigos (velocidade e dano sao definidos em scr_tiro_inimigo)
velocidade = 5;
dano = 10;</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (global.pausado) exit;

x += lengthdir_x(velocidade, direction);
y += lengthdir_y(velocidade, direction);

if (place_meeting(x, y, obj_parede)) {
    instance_destroy();
    exit;
}

if (place_meeting(x, y, obj_player)) {
    scr_dano_jogador(dano, false);
    instance_destroy();
    exit;
}

if (x &lt; 0 || y &lt; 0 || x &gt; room_width || y &gt; room_height) instance_destroy();</string>
          </argument>
        </arguments>
      </action>
    </event>
