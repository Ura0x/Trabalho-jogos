<!--This Document is generated by GameMaker, if you edit it by hand then you do so at your own risk!-->
<object>
  <spriteName>spr_john_baixo_parado</spriteName>
  <solid>0</solid>
  <visible>-1</visible>
  <depth>-4</depth>
  <persistent>0</persistent>
  <parentName>&lt;undefined&gt;</parentName>
  <maskName>spr_mascara_p</maskName>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Jogador (John Titor)
velocidade = 4;
vida_max = 100;
vida = vida_max;
invencivel = 0;        // frames sem levar dano depois de ser atingido
angulo = 0;            // para onde ele esta mirando
movendo = false;

// Arma
espera_tiro = 0;       // frames ate poder atirar de novo
calor = 0;             // 0 a 100
superaquecida = false;

// Escudo (liberado na fase 3)
escudo_ativo = 0;      // frames que o escudo ainda fica ligado
escudo_recarga = 0;    // frames ate poder usar de novo

image_speed = 0;</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Movimento, mira, tiro e escudo

if (global.pausado) {
    image_speed = 0;
    exit;
}

// ---------- Movimento (WASD ou setinhas) ----------
var mx, my;
mx = max(keyboard_check(ord('D')), keyboard_check(vk_right)) - max(keyboard_check(ord('A')), keyboard_check(vk_left));
my = max(keyboard_check(ord('S')), keyboard_check(vk_down)) - max(keyboard_check(ord('W')), keyboard_check(vk_up));
movendo = (mx != 0 || my != 0);
if (movendo) {
    scr_mover(point_direction(0, 0, mx, my), velocidade);
}

// ---------- Mira ----------
angulo = point_direction(x, y, mouse_x, mouse_y);

// ---------- Sprite (4 direcoes, parado ou correndo) ----------
if (movendo) {
    if (angulo &lt; 45 || angulo &gt;= 315) sprite_index = spr_john_dir_correndo;
    else if (angulo &lt; 135) sprite_index = spr_john_cima_correndo;
    else if (angulo &lt; 225) sprite_index = spr_john_esq_correndo;
    else sprite_index = spr_john_baixo_correndo;
} else {
    if (angulo &lt; 45 || angulo &gt;= 315) sprite_index = spr_john_dir_parado;
    else if (angulo &lt; 135) sprite_index = spr_john_cima_parado;
    else if (angulo &lt; 225) sprite_index = spr_john_esq_parado;
    else sprite_index = spr_john_baixo_parado;
}
image_speed = 0.15;

// ---------- Arma ----------
if (espera_tiro &gt; 0) espera_tiro -= 1;

// a arma esfria sozinha
calor = max(0, calor - 0.5);
if (superaquecida &amp;&amp; calor &lt;= 30) superaquecida = false;

if (mouse_check_button(mb_left) &amp;&amp; espera_tiro &lt;= 0 &amp;&amp; superaquecida == false) {
    var b;
    b = instance_create(x + lengthdir_x(30, angulo), y + 6 + lengthdir_y(30, angulo), obj_tiro);
    b.direction = angulo + random_range(-3, 3);
    b.image_angle = b.direction;
    sound_play(snd_tiro);

    if (global.arma_melhorada) {
        // fase 4 em diante: arma melhorada, dano dobrado e esquenta mais devagar
        b.dano = 2;
        espera_tiro = 7;
        calor += 4;
    } else {
        b.dano = 1;
        espera_tiro = 10;
        calor += 9;
    }
    if (calor &gt;= 100) {
        calor = 100;
        superaquecida = true;
        sound_play(snd_superaquecida);
    }
}

// ---------- Escudo (ESPACO) ----------
if (escudo_ativo &gt; 0) escudo_ativo -= 1;
if (escudo_recarga &gt; 0) escudo_recarga -= 1;
if (global.tem_escudo &amp;&amp; keyboard_check_pressed(vk_space) &amp;&amp; escudo_recarga &lt;= 0) {
    escudo_ativo = 120;    // 2 segundos ligado
    escudo_recarga = 420;  // 7 segundos ate poder usar de novo
    sound_play(snd_escudo);
}

if (invencivel &gt; 0) invencivel -= 1;</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Desenha o John, a arma e o escudo

// pisca depois de levar dano
if (invencivel &gt; 0 &amp;&amp; (invencivel div 4) mod 2 == 0) exit;

// arma vira de cabeca para baixo quando mira para a esquerda
var ey, mira_cima;
ey = 1;
if (angulo &gt; 90 &amp;&amp; angulo &lt; 270) ey = -1;
mira_cima = (angulo &gt;= 45 &amp;&amp; angulo &lt; 135);

// mirando para cima a arma fica atras do corpo
if (mira_cima) draw_sprite_ext(spr_arma, 0, x, y + 6, 1, ey, angulo, c_white, 1);
draw_self();
if (!mira_cima) draw_sprite_ext(spr_arma, 0, x, y + 6, 1, ey, angulo, c_white, 1);

// escudo
if (escudo_ativo &gt; 0) {
    draw_set_alpha(0.3);
    draw_set_color(c_aqua);
    draw_circle(x, y, 36, false);
    draw_set_alpha(1);
    draw_set_color(c_white);
    draw_circle(x, y, 36, true);
}</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
</object>
