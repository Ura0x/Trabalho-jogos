  <spriteName>spr_onnerb_frente</spriteName>
  <solid>0</solid>
  <visible>-1</visible>
  <depth>-2</depth>
  <persistent>0</persistent>
  <parentName>&lt;undefined&gt;</parentName>
  <maskName>&lt;undefined&gt;</maskName>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Fase 4: Onnerb sai do predio, conversa com o John e volta para dentro
// (se o jogador morreu e apertou R, a cena e pulada)
if (obj_controle.cena_onnerb == false) {
    instance_destroy();
    exit;
}
estado = "entrando";   // "entrando" -&gt; "falando" -&gt; "saindo"
porta_y = y;           // posicao da porta do predio (onde ele nasce e some)
image_speed = 0.08;</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>// A cena roda com o jogo pausado (os inimigos ficam parados)
switch (estado) {
    case "entrando":
        // desce da porta ate o meio da praca
        sprite_index = spr_onnerb_frente;
        image_speed = 0.08;    // passos (o GIF troca de quadro a cada 220 ms)
        y += 1.5;
        if (y &gt;= porta_y + 120) {
            estado = "falando";
            sprite_index = spr_onnerb_parado;
            image_speed = 0.04;   // boca abrindo e fechando enquanto fala
            scr_textos_fase("inicio");
            scr_dialogo_comecar("onnerb_sai");
        }
        break;

    case "saindo":
        // volta de costas para a porta e some
        sprite_index = spr_onnerb_costas;
        image_speed = 0.08;
        y -= 1.5;
        if (y &lt;= porta_y) {
            scr_textos_fase("onnerb_saiu");
            scr_dialogo_comecar("jogar");
            instance_destroy();
        }
        break;
}</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
</object>
