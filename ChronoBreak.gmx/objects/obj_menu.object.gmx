<!--This Document is generated by GameMaker, if you edit it by hand then you do so at your own risk!-->
<object>
  <spriteName>&lt;undefined&gt;</spriteName>
  <solid>0</solid>
  <visible>-1</visible>
  <depth>0</depth>
  <persistent>0</persistent>
  <parentName>&lt;undefined&gt;</parentName>
  <maskName>&lt;undefined&gt;</maskName>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Menu principal (primeira room do jogo: inicializa as variaveis globais)
global.pausado = false;
global.pular_intro = false;

// musica (global.musica guarda qual musica esta tocando, -1 = nenhuma)
sound_stop_all();
global.musica = -1;
global.musica_espera = 0;
scr_musica(mus_fase);
cx = room_width / 2;</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>scr_musica_manter();
var sobre_jogar, sobre_sair;
sobre_jogar = (abs(mouse_x - cx) &lt; 152 &amp;&amp; abs(mouse_y - 400) &lt; 42);
sobre_sair = (abs(mouse_x - cx) &lt; 152 &amp;&amp; abs(mouse_y - 500) &lt; 42);

if (keyboard_check_pressed(vk_enter) || (sobre_jogar &amp;&amp; mouse_check_button_pressed(mb_left))) room_goto(rm_fase1);
if (keyboard_check_pressed(vk_escape) || (sobre_sair &amp;&amp; mouse_check_button_pressed(mb_left))) game_end();

// atalho para testar/apresentar cada fase
if (keyboard_check_pressed(ord('1'))) room_goto(rm_fase1);
if (keyboard_check_pressed(ord('2'))) room_goto(rm_fase2);
if (keyboard_check_pressed(ord('3'))) room_goto(rm_fase3);
if (keyboard_check_pressed(ord('4'))) room_goto(rm_fase4);
if (keyboard_check_pressed(ord('5'))) room_goto(rm_fase5);
if (keyboard_check_pressed(ord('6'))) room_goto(rm_boss);</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>draw_set_halign(fa_center);
draw_set_valign(fa_top);

draw_set_font(fnt_titulo);
draw_set_color(c_aqua);
draw_text(cx, 140, "CHRONO BREAK");
draw_set_font(fnt_texto);
draw_set_color(c_white);
draw_text(cx, 210, "2089. A NEXUS controla o mundo. Um tecnico de manutencao viu o que nao devia.");

// botoes do pacote de UI (frame 1 = pressionado)
var f;
f = 0;
if (abs(mouse_x - cx) &lt; 152 &amp;&amp; abs(mouse_y - 400) &lt; 42) f = 1;
draw_sprite(spr_botao_jogar, f, cx, 400);
f = 0;
if (abs(mouse_x - cx) &lt; 152 &amp;&amp; abs(mouse_y - 500) &lt; 42) f = 1;
draw_sprite(spr_botao_sair, f, cx, 500);

draw_set_font(fnt_pequena);
draw_set_color(c_gray);
draw_text(cx, 600, "ENTER jogar  |  ESC sair  |  1 a 6: ir direto para uma fase");
draw_text(cx, 625, "WASD/setas mover   Mouse mirar/atirar   E ler terminal   ESPACO escudo   P pausa");

draw_set_halign(fa_left);
draw_sprite(spr_cursor, 0, mouse_x, mouse_y);</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
</object>
