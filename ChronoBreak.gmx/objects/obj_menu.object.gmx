<!--This Document is generated by GameMaker, if you edit it by hand then you do so at your own risk!-->
<object>
  <spriteName>&lt;undefined&gt;</spriteName>
  <solid>0</solid>
  <visible>-1</visible>
  <depth>0</depth>
  <persistent>0</persistent>
  <parentName>&lt;undefined&gt;</parentName>
  <maskName>&lt;undefined&gt;</maskName>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Menu principal (primeira room do jogo: inicializa as variaveis globais)
global.pausado = false;
global.pular_intro = false;
global.tem_escudo = false;       // cada fase define de novo o que o jogador ja tem
global.arma_melhorada = false;

// musica (global.musica guarda qual musica esta tocando, -1 = nenhuma)
sound_stop_all();
scr_musica_parar();   // garante que a musica do final (ou outra) parou
scr_musica(mus_fase);
cx = room_width / 2;
// posicao dos botoes (o START fica em cima do START desenhado no fundo)
quadro = 0;   // quadro da animacao do fundo (spr_menu, 60 quadros)
bx = 648;
by_jogar = 359;
by_sair = 470;</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>// anima o fundo: o GIF original troca de quadro a cada 70 ms (70 ms = ~4 frames do jogo, entao avanca 1/4.2 = ~0.24 por frame)
quadro += 0.24;
if (quadro >= 60) quadro -= 60;

var sobre_jogar, sobre_sair;
sobre_jogar = (abs(mouse_x - bx) &lt; 157 &amp;&amp; abs(mouse_y - by_jogar) &lt; 48);
sobre_sair = (abs(mouse_x - bx) &lt; 157 &amp;&amp; abs(mouse_y - by_sair) &lt; 48);

if (keyboard_check_pressed(vk_enter) || (sobre_jogar &amp;&amp; mouse_check_button_pressed(mb_left))) room_goto(rm_fase1);
if (keyboard_check_pressed(vk_escape) || (sobre_sair &amp;&amp; mouse_check_button_pressed(mb_left))) game_end();

// atalho para testar/apresentar cada fase
if (keyboard_check_pressed(ord('1'))) room_goto(rm_fase1);
if (keyboard_check_pressed(ord('2'))) room_goto(rm_fase2);
if (keyboard_check_pressed(ord('3'))) room_goto(rm_fase3);
if (keyboard_check_pressed(ord('4'))) room_goto(rm_fase4);
if (keyboard_check_pressed(ord('5'))) room_goto(rm_fase5);
if (keyboard_check_pressed(ord('6'))) room_goto(rm_boss);</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>draw_set_halign(fa_center);
draw_set_valign(fa_top);

// fundo animado
draw_sprite(spr_menu, quadro, 0, 0);

// nome do jogo, centralizado acima dos botoes
scr_titulo(cx, 205, "CHRONO BREAK", c_aqua, 1);
draw_set_halign(fa_center);

// botoes (frame 1 = mouse em cima)
var f;
f = 0;
if (abs(mouse_x - bx) &lt; 157 &amp;&amp; abs(mouse_y - by_jogar) &lt; 48) f = 1;
draw_sprite(spr_botao_jogar, f, bx, by_jogar);
f = 0;
if (abs(mouse_x - bx) &lt; 157 &amp;&amp; abs(mouse_y - by_sair) &lt; 48) f = 1;
draw_sprite(spr_botao_sair, f, bx, by_sair);

draw_set_font(fnt_pequena);
draw_set_color(c_gray);
draw_text(cx, 660, "ENTER jogar  |  ESC sair  |  1 a 6: ir direto para uma fase");
draw_text(cx, 685, "WASD/setas mover   Mouse mirar/atirar   E ler terminal   ESPACO escudo   P pausa");

draw_set_halign(fa_left);
draw_sprite(spr_cursor, 0, mouse_x, mouse_y);</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
</object>
