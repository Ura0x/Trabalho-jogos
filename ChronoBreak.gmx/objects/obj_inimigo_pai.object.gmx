  <maskName>&lt;undefined&gt;</maskName>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Pai de todos os inimigos (guarda, drone, robo e chefe)
// Os filhos chamam event_inherited() e depois mudam os valores que quiserem.
vida = 3;
invulneravel = false;
piscar = 0;          // frames piscando depois de levar tiro
alerta = false;      // true = ja viu o jogador
velocidade = 1;
dist = 9999;         // distancia ate o jogador
angulo = 0;          // direcao ate o jogador</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Codigo comum a todos os inimigos
if (piscar &gt; 0) piscar -= 1;

// morreu
if (vida &lt;= 0) {
    instance_create(x, y, obj_explosao);
    instance_destroy();
    exit;
}

// distancia e direcao ate o jogador (usadas pela IA dos filhos)
if (instance_exists(obj_player)) {
    dist = point_distance(x, y, obj_player.x, obj_player.y);
    angulo = point_direction(x, y, obj_player.x, obj_player.y);
}</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Fica meio transparente quando leva tiro ou quando esta protegido
// (a versao Lite do GameMaker so aceita c_white como cor no draw_sprite_ext)
var a;
a = 1;
if (invulneravel) a = 0.5;
if (piscar &gt; 0) a = 0.4;
draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, 0, c_white, a);</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
</object>
