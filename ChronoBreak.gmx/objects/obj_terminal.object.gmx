  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Terminal com registros da historia (aperte E perto dele)
titulo = "Terminal";
texto1 = "";
texto2 = "";
switch (room) {
    case rm_fase1:
        titulo = "Arquivo - Projeto Chrono Gate";
        texto1 = "Plantas de uma maquina do tempo experimental. Local: instalacao temporal no centro da cidade. Acesso restrito ao diretor executivo.";
        texto2 = "ACESSO NAO AUTORIZADO DETECTADO. Arquivo bloqueado.";
        break;
    case rm_fase2:
        titulo = "Tela publica NEXUS";
        texto1 = "PROCURADO: John Titor, 22 anos. Terrorista. Roubou tecnologia capaz de colocar milhares de vidas em risco. Denuncie.";
        texto2 = "NEXUS: energia, saude, transporte e seguranca. Nos cuidamos de tudo para voce.";
        break;
    case rm_fase3:
        titulo = "Registro 2056";
        texto1 = "A NEXUS assume hospitais, transportes, distribuicao de alimentos e redes de comunicacao.";
        texto2 = "A populacao passa a confiar na empresa porque os servicos realmente melhoram.";
        break;
    case rm_fase4:
        titulo = "Registro 2071";
        texto1 = "Governos ainda existem, mas dependem inteiramente dos sistemas da NEXUS.";
        texto2 = "Quem tenta recuperar o controle e acusado de colocar a estabilidade mundial em risco.";
        break;
    case rm_fase5:
        titulo = "Registro 2089 - Projeto Chrono Gate";
        texto1 = "A empresa desenvolve secretamente uma maquina capaz de transferir pessoas ao passado.";
        texto2 = "Objetivo: eliminar a unica coisa que ainda ameaca seu dominio: a possibilidade de que sua ascensao nunca aconteca.";
        break;
}
perto = false;</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (global.pausado) exit;

perto = false;
if (instance_exists(obj_player)) {
    if (point_distance(x + sprite_width / 2, y + sprite_height / 2, obj_player.x, obj_player.y) &lt; 100) perto = true;
}

if (perto &amp;&amp; keyboard_check_pressed(ord('E'))) {
    sound_play(snd_terminal);
    scr_fala(titulo, texto1);
    if (texto2 != "") scr_fala(titulo, texto2);
    scr_dialogo_comecar("continuar");
}</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>// o terminal ja esta desenhado no mapa da fase: aqui so aparece o aviso
var cx, cy, texto, i;
cx = x + sprite_width / 2;
cy = y - 30 + 6 * sin(current_time / 200);   // sobe e desce
if (perto) {
    draw_set_font(fnt_texto);
    texto = "[E] Ler";
} else {
    draw_set_font(fnt_titulo);
    texto = "!";
}
draw_set_halign(fa_center);
draw_set_valign(fa_middle);
// contorno preto
draw_set_color(c_black);
for (i = 0; i &lt; 8; i += 1) draw_text(cx + lengthdir_x(3, i * 45), cy + lengthdir_y(3, i * 45), texto);
// texto amarelo
draw_set_color(c_yellow);
draw_text(cx, cy, texto);
draw_set_halign(fa_left);
draw_set_valign(fa_top);</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
</object>
