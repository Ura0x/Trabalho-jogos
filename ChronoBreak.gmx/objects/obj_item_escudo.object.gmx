        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (global.pausado) exit;
t += 1;

if (place_meeting(x, y, obj_player)) {
    global.tem_escudo = true;
    sound_play(snd_item);
    scr_textos_fase("escudo");
    scr_dialogo_comecar("continuar");
    instance_destroy();
}</string>
