      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Tela final
t = 0;
scr_musica(mus_final);
texto = "2053. O mundo ainda nao sabe o que esta por vir.";</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>t += 1;
if (t &gt; 400 &amp;&amp; keyboard_check_pressed(vk_enter)) room_goto(rm_menu);</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>draw_set_halign(fa_center);
draw_set_valign(fa_middle);

// texto aparecendo letra por letra
var n;
n = max(0, floor((t - 60) / 4));
draw_set_font(fnt_texto);
draw_set_color(c_white);
draw_text(room_width / 2, room_height / 2, string_copy(texto, 1, n));

if (t &gt; 400) {
    draw_set_font(fnt_titulo);
    draw_set_color(c_aqua);
    draw_text(room_width / 2, room_height / 2 + 120, "FIM");
    draw_set_font(fnt_pequena);
    draw_set_color(c_gray);
    draw_text(room_width / 2, room_height / 2 + 180, "Obrigado por jogar CHRONO BREAK   -   ENTER para voltar ao menu");
}

// comeca branco (saindo do portal) e escurece
if (t &lt; 90) {
    draw_set_alpha(1 - t / 90);
    draw_set_color(c_white);
    draw_rectangle(0, 0, room_width, room_height, false);
    draw_set_alpha(1);
}

draw_set_halign(fa_left);
draw_set_valign(fa_top);</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
</object>
