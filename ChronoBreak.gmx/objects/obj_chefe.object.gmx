<!--This Document is generated by GameMaker, if you edit it by hand then you do so at your own risk!-->
<object>
  <spriteName>spr_chefe_parado1</spriteName>
  <solid>0</solid>
  <visible>-1</visible>
  <depth>-3</depth>
  <persistent>0</persistent>
  <parentName>obj_inimigo_pai</parentName>
  <maskName>&lt;undefined&gt;</maskName>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Chefe final: Onnerb dentro da armadura. Fica parado no centro.
event_inherited();
vida_max = 600;
vida = vida_max;
alerta = true;
fase = 1;            // 1 = so tiros, 2 = tiros + zonas de impacto
ataque = 0;          // 0 = circulo, 1 = espiral, 2 = leque mirado
tempo = 0;           // tempo dentro do ataque atual
giro = 0;            // angulo da espiral
espera_zona = 90;
atirando = 0;        // frames mostrando a animacao de tiro
image_speed = 0.07;</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="1" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Armadura explode e sobra o Onnerb de joelhos
instance_create(x, y, obj_chefe_morte);   // animacao da armadura explodindo
instance_create(x, y + 40, obj_onnerb);
with (obj_zona_impacto) instance_destroy();
with (obj_tiro_inimigo) instance_destroy();</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>event_inherited();
if (global.pausado) {
    image_speed = 0;
    exit;
}
if (!instance_exists(obj_player)) exit;

// ---------- Transicao em 50% da vida ----------
if (fase == 1 &amp;&amp; vida &lt;= vida_max / 2) {
    fase = 2;
    invulneravel = true;   // volta a levar dano quando o dialogo acabar
    obj_controle.flash = 40;
    sound_play(snd_alerta);
    repeat (4) instance_create(x + random_range(-50, 50), y + random_range(-60, 60), obj_explosao);
    sprite_index = spr_chefe_carrega2;   // carregando a forma vermelha
    scr_textos_fase("chefe_metade");
    scr_dialogo_comecar("chefe_fase2");
    exit;
}

// ---------- Ataques (um de cada vez, em ciclo) ----------
tempo += 1;
var i;
switch (ataque) {
    case 0: // CIRCULO: 20 tiros para todos os lados
        if (tempo mod 40 == 0) {
            for (i = 0; i &lt; 20; i += 1) scr_tiro_chefe(i * 18 + tempo, 4);
        }
        if (tempo &gt;= 130) { ataque = 1; tempo = 0; }
        break;

    case 1: // ESPIRAL: dois tiros girando
        if (tempo mod 5 == 0) {
            giro += 17;
            scr_tiro_chefe(giro, 4);
            scr_tiro_chefe(giro + 180, 4);
        }
        if (tempo &gt;= 150) { ataque = 2; tempo = 0; }
        break;

    case 2: // LEQUE: 5 tiros mirados no jogador
        if (tempo mod 30 == 0) {
            for (i = -2; i &lt;= 2; i += 1) scr_tiro_chefe(angulo + i * 12, 6);
        }
        if (tempo &gt;= 130) { ataque = 0; tempo = 0; }
        break;
}

// ---------- Modo 2: zonas de impacto ----------
if (fase == 2) {
    espera_zona -= 1;
    if (espera_zona &lt;= 0) {
        // quanto menos vida, mais zonas
        var qtd;
        qtd = 1 + floor((vida_max / 2 - vida) / 75);
        // uma zona sempre cai em cima do jogador
        instance_create(obj_player.x - 64, obj_player.y - 64, obj_zona_impacto);
        repeat (qtd) instance_create(64 + irandom(room_width - 256), 128 + irandom(room_height - 320), obj_zona_impacto);
        espera_zona = 150;
    }
}

// ---------- Animacao ----------
// azul na fase 1, vermelho na fase 2; "atira" logo depois de cada tiro
if (atirando &gt; 0) atirando -= 1;
if (atirando &gt; 0) {
    if (fase == 1) sprite_index = spr_chefe_atira1;
    else sprite_index = spr_chefe_atira2;
    image_speed = 0.22;
} else {
    if (fase == 1) sprite_index = spr_chefe_parado1;
    else sprite_index = spr_chefe_parado2;
    image_speed = 0.07;
}</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Chefe: fica branco quando leva tiro, meio transparente quando esta protegido
var a;
a = 1;
if (invulneravel) a = 0.6;
if (piscar &gt; 0) draw_sprite_ext(spr_chefe_dano, fase - 1, x, y, 1, 1, 0, c_white, 1);
else draw_sprite_ext(sprite_index, image_index, x, y, 1, 1, 0, c_white, a);</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
</object>
