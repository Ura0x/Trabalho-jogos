  <maskName>&lt;undefined&gt;</maskName>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Fase 4: vai criando a horda de inimigos aos poucos
total = 30;          // quantos inimigos ainda vao aparecer
espera = 120;
max_na_tela = 14;    // nunca mais que isso ao mesmo tempo

// pontos de onde os inimigos saem
ponto_x[0] = 64;   ponto_y[0] = 400;
ponto_x[1] = 1216; ponto_y[1] = 400;
ponto_x[2] = 64;   ponto_y[2] = 640;
ponto_x[3] = 1216; ponto_y[3] = 640;</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (global.pausado) exit;
if (obj_controle.estado != "jogando") exit;
if (total &lt;= 0) exit;

espera -= 1;
if (espera &lt;= 0 &amp;&amp; instance_number(obj_inimigo_pai) &lt; max_na_tela) {
    var p, tipo, e, i;
    // nasce no ponto mais longe do jogador (para nao cercar ele)
    p = 0;
    if (instance_exists(obj_player)) {
        for (i = 1; i &lt; 4; i += 1) {
            if (point_distance(ponto_x[i], ponto_y[i], obj_player.x, obj_player.y) &gt; point_distance(ponto_x[p], ponto_y[p], obj_player.x, obj_player.y)) p = i;
        }
    }
    tipo = choose(obj_guarda, obj_guarda, obj_drone, obj_robo);
    e = instance_create(ponto_x[p], ponto_y[p], tipo);
    e.alerta = true;
    total -= 1;
    espera = 45;
}</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
</object>
