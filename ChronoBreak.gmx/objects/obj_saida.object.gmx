        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Saida da fase. Fica trancada ate o objetivo ser cumprido.
aberta = false;</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (global.pausado || aberta == false) exit;

if (place_meeting(x, y, obj_player)) {
    if (obj_controle.estado == "saida_aberta") {
        obj_controle.estado = "saindo";
        scr_textos_fase("saida");
        if (room == rm_boss) scr_dialogo_comecar("portal");
        else scr_dialogo_comecar("proxima_fase");
    }
}</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>// na room do chefe o portal so aparece depois que ele e derrotado
if (room == rm_boss &amp;&amp; aberta == false) exit;

var a, texto;
if (aberta) {
    a = 0.55 + 0.25 * sin(current_time / 150);
    texto = "SAIDA";
    if (room == rm_fase5) texto = "ELEVADOR";
    if (room == rm_boss) texto = "PORTAL";
} else {
    a = 0.2;
    texto = "TRANCADA";
}
// o sprite ja e verde (a versao Lite so aceita c_white aqui)
draw_sprite_ext(sprite_index, 0, x, y, image_xscale, image_yscale, 0, c_white, a);

draw_set_font(fnt_pequena);
draw_set_halign(fa_center);
draw_set_valign(fa_middle);
draw_set_color(c_white);
draw_text(x + sprite_width / 2, y + sprite_height / 2, texto);
draw_set_halign(fa_left);
draw_set_valign(fa_top);</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
</object>
