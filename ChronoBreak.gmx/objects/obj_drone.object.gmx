<!--This Document is generated by GameMaker, if you edit it by hand then you do so at your own risk!-->
<object>
  <spriteName>spr_drone</spriteName>
  <solid>0</solid>
  <visible>-1</visible>
  <depth>-5</depth>
  <persistent>0</persistent>
  <parentName>obj_inimigo_pai</parentName>
  <maskName>&lt;undefined&gt;</maskName>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Drone: voa em volta do jogador (passa por cima das paredes) e atira
event_inherited();
vida = 2;
velocidade = 2.6;
orbita = random(360);       // angulo em volta do jogador
raio = 150;                 // distancia que tenta manter
espera_tiro = 90 + irandom(60);
image_speed = 0.25;</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>event_inherited();
if (global.pausado) {
    image_speed = 0;
    exit;
}
image_speed = 0.25;
if (!instance_exists(obj_player)) exit;

if (dist &lt; 400) alerta = true;

if (alerta) {
    // ponto em volta do jogador que o drone persegue
    orbita += 1.2;
    var ax, ay, d;
    ax = obj_player.x + lengthdir_x(raio, orbita);
    ay = obj_player.y + lengthdir_y(raio, orbita);
    // nao deixa o ponto sair da tela
    ax = max(48, min(room_width - 48, ax));
    ay = max(64, min(room_height - 48, ay));

    if (point_distance(x, y, ax, ay) &gt; velocidade) {
        d = point_direction(x, y, ax, ay);
        x += lengthdir_x(velocidade, d);
        y += lengthdir_y(velocidade, d);
    }

    espera_tiro -= 1;
    if (espera_tiro &lt;= 0) {
        scr_tiro_inimigo(x, y, angulo, 4.5, 6);
        espera_tiro = 100 + irandom(40);
    }
}</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
</object>
