<!--This Document is generated by GameMaker, if you edit it by hand then you do so at your own risk!-->
<object>
  <spriteName>&lt;undefined&gt;</spriteName>
  <solid>0</solid>
  <visible>-1</visible>
  <depth>-1000</depth>
  <persistent>0</persistent>
  <parentName>&lt;undefined&gt;</parentName>
  <maskName>&lt;undefined&gt;</maskName>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Controlador da fase
// Existe um obj_controle em cada room de fase (e a primeira instancia da room).
// Ele cuida de: dialogos, estado da fase, HUD, pausa, game over e o final.

global.pausado = false;

// O que o jogador ja tem depende da fase.
// Assim da para testar qualquer fase direto pelo menu (teclas 1 a 6).
global.tem_escudo = (room == rm_fase4 || room == rm_fase5 || room == rm_boss);
global.arma_melhorada = (room == rm_fase4 || room == rm_fase5 || room == rm_boss);

// Estados da fase:
// "inicio" -&gt; "jogando" -&gt; "saida_aberta" -&gt; "saindo"
// e tambem "morto" e "portal" (final do jogo)
estado = "inicio";
pausa = false;       // pausa com a tecla P
flash = 0;           // tela branca piscando (em frames)

// Dialogo
dialogo_ativo = false;
fala_total = 0;
fala_atual = 0;
letras = 0;          // quantas letras ja apareceram (efeito maquina de escrever)
acao_final = "";

// Fase 3 (robos guardioes e item do escudo)
robos_comuns = 99;
robos_derrotados = 0;
guardioes_avisados = false;

// Final do jogo
tempo_portal = 0;

// Nome da fase para o HUD
nome_fase = "";
switch (room) {
    case rm_fase1: nome_fase = "FASE 1 - Instalacao de Energia do Distrito 12"; break;
    case rm_fase2: nome_fase = "FASE 2 - Ruas do Distrito 12"; break;
    case rm_fase3: nome_fase = "FASE 3 - Setor Industrial"; break;
    case rm_fase4: nome_fase = "FASE 4 - Centro da Cidade"; break;
    case rm_fase5: nome_fase = "FASE 5 - Predio da NEXUS"; break;
    case rm_boss:  nome_fase = "FASE 6 - Chrono Gate"; break;
}

// Musica de fundo
if (room == rm_boss) scr_musica(mus_chefe);
else scr_musica(mus_fase);

// A fase comeca com o dialogo de introducao
// (se o jogador morreu e apertou R, pula a introducao)
if (global.pular_intro == false) scr_textos_fase("inicio");
global.pular_intro = false;
scr_dialogo_comecar("jogar");</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Logica principal da fase

if (flash &gt; 0) flash -= 1;

// ---------------- DIALOGO ----------------
// Enquanto tem dialogo na tela, o resto do jogo fica parado.
if (dialogo_ativo) {
    if (fala_atual &lt; fala_total) {
        letras += 1.5;
        if (keyboard_check_pressed(vk_enter)) {
            if (letras &lt; string_length(fala_texto[fala_atual])) {
                // ENTER no meio da frase: mostra a frase inteira
                letras = string_length(fala_texto[fala_atual]);
            } else {
                // proxima fala
                fala_atual += 1;
                sound_play(snd_dialogo);
                letras = 0;
            }
        }
    }

    // Acabaram as falas: fecha o dialogo e executa a acao
    if (fala_atual &gt;= fala_total) {
        dialogo_ativo = false;
        fala_total = 0;
        global.pausado = false;

        switch (acao_final) {
            case "jogar":
                estado = "jogando";
                break;
            case "abrir_saida":
                estado = "saida_aberta";
                with (obj_saida) aberta = true;
                sound_play(snd_saida);
                break;
            case "proxima_fase":
                room_goto_next();
                break;
            case "chefe_fase2":
                with (obj_chefe) invulneravel = false;
                break;
            case "portal":
                estado = "portal";
                global.pausado = true;
                sound_play(snd_portal);
                break;
            // "continuar": nao faz nada, o jogo so continua
        }
    }
    exit;
}

// ---------------- FINAL (entrando no portal) ----------------
if (estado == "portal") {
    tempo_portal += 1;
    // a tela treme cada vez mais forte
    view_xview[0] = random_range(-1, 1) * tempo_portal / 12;
    view_yview[0] = random_range(-1, 1) * tempo_portal / 12;
    if (tempo_portal &gt;= 240) room_goto(rm_final);
    exit;
}

// ---------------- GAME OVER ----------------
if (estado == "morto") {
    if (keyboard_check_pressed(ord('R'))) {
        global.pular_intro = true;
        room_restart();
    }
    if (keyboard_check_pressed(ord('M'))) room_goto(rm_menu);
    exit;
}
if (!instance_exists(obj_player)) {
    estado = "morto";
    global.pausado = true;
    exit;
}

// ---------------- PAUSA ----------------
if (keyboard_check_pressed(ord('P'))) {
    pausa = !pausa;
    global.pausado = pausa;
}
if (pausa) {
    if (keyboard_check_pressed(ord('M'))) room_goto(rm_menu);
    exit;
}

// ---------------- OBJETIVO DA FASE ----------------
if (estado == "jogando") {

    // Fase 3: conta os robos comuns.
    // Os 2 guardioes da saida so acordam quando os comuns acabarem.
    if (room == rm_fase3) {
        robos_comuns = 0;
        with (obj_robo) {
            if (guardiao == false) other.robos_comuns += 1;
        }
        if (robos_comuns == 0 &amp;&amp; guardioes_avisados == false) {
            guardioes_avisados = true;
            scr_textos_fase("guardioes");
            scr_dialogo_comecar("continuar");
            exit;
        }
    }

    // Todos os inimigos derrotados? (na fase 4 conta tambem os que ainda vao nascer)
    var restantes;
    restantes = instance_number(obj_inimigo_pai);
    if (instance_exists(obj_spawner)) restantes += obj_spawner.total;

    if (restantes == 0) {
        scr_textos_fase("limpo");
        scr_dialogo_comecar("abrir_saida");
    }
}</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// HUD, caixa de dialogo e telas de pausa / game over

// Na room do chefe a view treme no final, entao tudo e desenhado
// a partir do canto da view (vx, vy). Nas outras rooms isso e 0.
var vx, vy, w, h;
vx = view_xview[0];
vy = view_yview[0];
w = room_width;
h = room_height;

draw_set_font(fnt_texto);
draw_set_valign(fa_top);

// ---------------- HUD ----------------
if (instance_exists(obj_player)) {
    // barra de vida (sprite do pacote de UI)
    draw_sprite(spr_hp_barra, 0, vx + 16, vy + 8);
    draw_sprite_ext(spr_hp, 0, vx + 16 + 52, vy + 8 + 16, (160 / 172) * obj_player.vida / obj_player.vida_max, 1, 0, c_white, 1);

    // calor da arma
    if (global.arma_melhorada == false) {
        draw_set_halign(fa_left);
        draw_set_color(c_white);
        draw_text(vx + 250, vy + 10, "CALOR");
        draw_set_color(c_black);
        draw_rectangle(vx + 320, vy + 14, vx + 480, vy + 30, false);
        draw_set_color(merge_color(c_yellow, c_red, obj_player.calor / 100));
        draw_rectangle(vx + 320, vy + 14, vx + 320 + 160 * obj_player.calor / 100, vy + 30, false);
        draw_set_color(c_white);
        draw_rectangle(vx + 320, vy + 14, vx + 480, vy + 30, true);
        if (obj_player.superaquecida) {
            draw_set_color(c_red);
            draw_text(vx + 490, vy + 10, "SUPERAQUECIDA!");
        }
    }

    // escudo
    if (global.tem_escudo) {
        draw_set_halign(fa_left);
        draw_set_color(c_aqua);
        if (obj_player.escudo_ativo &gt; 0) draw_text(vx + 250, vy + 36, "ESCUDO LIGADO");
        else if (obj_player.escudo_recarga &gt; 0) draw_text(vx + 250, vy + 36, "Escudo recarregando: " + string(ceil(obj_player.escudo_recarga / 60)) + "s");
        else draw_text(vx + 250, vy + 36, "ESCUDO PRONTO [ESPACO]");
    }
}

// nome da fase e objetivo
draw_set_halign(fa_right);
draw_set_color(c_white);
draw_text(vx + w - 16, vy + 8, nome_fase);
if (estado == "jogando") {
    var restantes;
    restantes = instance_number(obj_inimigo_pai);
    if (instance_exists(obj_spawner)) restantes += obj_spawner.total;
    draw_set_color(c_yellow);
    draw_text(vx + w - 16, vy + 32, "Inimigos restantes: " + string(restantes));
}
if (estado == "saida_aberta") {
    draw_set_color(c_lime);
    draw_text(vx + w - 16, vy + 32, "Va ate a SAIDA");
}

// barra de vida do chefe
if (instance_exists(obj_chefe)) {
    draw_set_halign(fa_center);
    draw_set_color(c_white);
    draw_text(vx + w / 2, vy + 50, "ONNERB ERIC - DIRETOR EXECUTIVO DA NEXUS");
    draw_set_color(c_black);
    draw_rectangle(vx + w / 2 - 300, vy + 74, vx + w / 2 + 300, vy + 88, false);
    draw_set_color(c_red);
    if (obj_chefe.invulneravel) draw_set_color(c_gray);
    draw_rectangle(vx + w / 2 - 300, vy + 74, vx + w / 2 - 300 + 600 * obj_chefe.vida / obj_chefe.vida_max, vy + 88, false);
    draw_set_color(c_white);
    draw_rectangle(vx + w / 2 - 300, vy + 74, vx + w / 2 + 300, vy + 88, true);
}

// dica de controles
draw_set_font(fnt_pequena);
draw_set_halign(fa_left);
draw_set_color(c_white);
draw_set_alpha(0.7);
draw_text(vx + 16, vy + h - 22, "WASD mover   Mouse mirar/atirar   E ler terminal   ESPACO escudo   P pausa");
draw_set_alpha(1);
draw_set_font(fnt_texto);

// mira
if (instance_exists(obj_player) &amp;&amp; dialogo_ativo == false) {
    draw_set_color(c_white);
    draw_circle(mouse_x, mouse_y, 10, true);
    draw_line(mouse_x - 16, mouse_y, mouse_x - 5, mouse_y);
    draw_line(mouse_x + 5, mouse_y, mouse_x + 16, mouse_y);
    draw_line(mouse_x, mouse_y - 16, mouse_x, mouse_y - 5);
    draw_line(mouse_x, mouse_y + 5, mouse_x, mouse_y + 16);
}

// ---------------- FLASH BRANCO ----------------
if (flash &gt; 0) {
    draw_set_alpha(flash / 40);
    draw_set_color(c_white);
    draw_rectangle(vx - 50, vy - 50, vx + w + 50, vy + h + 50, false);
    draw_set_alpha(1);
}

// ---------------- CAIXA DE DIALOGO ----------------
if (dialogo_ativo &amp;&amp; fala_atual &lt; fala_total) {
    draw_set_alpha(0.88);
    draw_set_color(c_black);
    draw_rectangle(vx + 40, vy + h - 210, vx + w - 40, vy + h - 40, false);
    draw_set_alpha(1);
    draw_set_color(c_white);
    draw_rectangle(vx + 40, vy + h - 210, vx + w - 40, vy + h - 40, true);

    // cor do nome de quem fala
    var nome, cor;
    nome = fala_nome[fala_atual];
    cor = c_yellow;
    if (nome == "IA") cor = c_aqua;
    if (nome == "John") cor = c_lime;
    if (nome == "Onnerb") cor = c_red;

    draw_set_halign(fa_left);
    if (nome != "") {
        draw_set_color(cor);
        draw_text(vx + 64, vy + h - 198, nome);
    }
    draw_set_color(c_white);
    draw_text_ext(vx + 64, vy + h - 168, string_copy(fala_texto[fala_atual], 1, floor(letras)), 26, w - 160);

    draw_set_halign(fa_right);
    draw_set_color(c_gray);
    draw_text(vx + w - 60, vy + h - 70, "ENTER &gt;&gt;");
}

// ---------------- PAUSA ----------------
if (pausa) {
    draw_set_alpha(0.6);
    draw_set_color(c_black);
    draw_rectangle(vx, vy, vx + w, vy + h, false);
    draw_set_alpha(1);
    draw_set_halign(fa_center);
    draw_set_font(fnt_titulo);
    draw_set_color(c_white);
    draw_text(vx + w / 2, vy + h / 2 - 60, "PAUSADO");
    draw_set_font(fnt_texto);
    draw_text(vx + w / 2, vy + h / 2 + 10, "P - continuar      M - menu");
}

// ---------------- GAME OVER ----------------
if (estado == "morto") {
    draw_set_alpha(0.7);
    draw_set_color(c_black);
    draw_rectangle(vx, vy, vx + w, vy + h, false);
    draw_set_alpha(1);
    draw_set_halign(fa_center);
    draw_set_font(fnt_titulo);
    draw_set_color(c_red);
    draw_text(vx + w / 2, vy + h / 2 - 60, "VOCE MORREU");
    draw_set_font(fnt_texto);
    draw_set_color(c_white);
    draw_text(vx + w / 2, vy + h / 2 + 10, "R - tentar de novo      M - menu");
}

// ---------------- PORTAL (tela ficando branca) ----------------
if (estado == "portal") {
    draw_set_alpha(min(1, tempo_portal / 200));
    draw_set_color(c_white);
    draw_rectangle(vx - 100, vy - 100, vx + w + 100, vy + h + 100, false);
    draw_set_alpha(1);
}

draw_set_halign(fa_left);</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
</object>
